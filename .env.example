# Runtime
APP_NAME=enterprise-rag-api
APP_ENV=development
LOG_LEVEL=INFO

# Prometheus scraping; set a random value of at least 32 characters outside local use.
# Without a value, /metrics is denied.
METRICS_SCRAPE_TOKEN=

# Local host-process connections (docker-compose binds only to loopback).
DATABASE_URL=postgresql+asyncpg://rag_runtime@127.0.0.1:55432/enterprise_rag
MIGRATION_DATABASE_URL=postgresql+asyncpg://rag_migrator@127.0.0.1:55432/enterprise_rag
REDIS_URL=redis://127.0.0.1:56379/0

# Optional overrides for API containers using Compose service DNS.
COMPOSE_DATABASE_URL=postgresql+asyncpg://rag_runtime@db:5432/enterprise_rag
COMPOSE_MIGRATION_DATABASE_URL=postgresql+asyncpg://rag_migrator@db:5432/enterprise_rag
COMPOSE_REDIS_URL=redis://state:6379/0

