# Runtime
APP_NAME=enterprise-rag-api
APP_ENV=development
LOG_LEVEL=INFO

# Prometheus scraping; set a random value of at least 32 characters outside local use.
# Without a value, /metrics is denied.
METRICS_SCRAPE_TOKEN=

# Local Compose service connections. Do not use trust-authenticated local URLs outside Compose.
DATABASE_URL=postgresql+asyncpg://rag_runtime@db:5432/enterprise_rag
MIGRATION_DATABASE_URL=postgresql+asyncpg://rag_migrator@db:5432/enterprise_rag
REDIS_URL=redis://state:6379/0

# Ingestion storage. Local mode uses the shared Compose volume; production should use private S3.
BLOB_BACKEND=local
BLOB_LOCAL_ROOT=/var/lib/rag/blobs
BLOB_BUCKET=enterprise-rag-documents
BLOB_ENDPOINT_URL=
BLOB_REGION=us-east-1
BLOB_ACCESS_KEY_ID=
BLOB_SECRET_ACCESS_KEY=
BLOB_MAX_UPLOAD_BYTES=104857600
BLOB_MAX_PAGES=250
INGESTION_MAX_QUEUE_SIZE=500
INGESTION_MAX_CONCURRENCY=2
INGESTION_CHUNK_CHARS=2400
INGESTION_CHUNK_OVERLAP_CHARS=300

# Proposed embedding defaults; confirm model and dimension with the owner before production.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
EMBEDDING_TIMEOUT_SECONDS=20

# Tenant/key fixed-window limits. The local fallback is deliberately stricter.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MEMORY_FALLBACK_REQUESTS=10
RATE_LIMIT_MEMORY_FALLBACK_WINDOW_SECONDS=60

