# Runtime
APP_NAME=enterprise-rag-api
APP_ENV=development
LOG_LEVEL=INFO

# Prometheus scraping; set a random value of at least 32 characters outside local use.
# Without a value, /metrics is denied.
METRICS_SCRAPE_TOKEN=

# Local Compose service connections. Do not use trust-authenticated local URLs outside Compose.
DATABASE_URL=postgresql+asyncpg://rag_runtime@db:5432/enterprise_rag
MIGRATION_DATABASE_URL=postgresql+asyncpg://rag_migrator@db:5432/enterprise_rag
REDIS_URL=redis://state:6379/0

# Tenant/key fixed-window limits. The local fallback is deliberately stricter.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MEMORY_FALLBACK_REQUESTS=10
RATE_LIMIT_MEMORY_FALLBACK_WINDOW_SECONDS=60

