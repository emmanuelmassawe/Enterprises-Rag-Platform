# Set these through a local ignored .env file or a protected deployment environment.
APP_ORIGIN=http://localhost:3001
RAG_API_URL=http://localhost:8000
AUTH_URL=http://localhost:3001
AUTH_TRUST_HOST=true
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Each approved user has a distinct API key. Roles are checked here and scopes are
# independently enforced by the API. Store this JSON only as a protected secret.
WEB_IDENTITY_DIRECTORY_JSON={}
# Optional Grafana Faro collector URL; browser telemetry never includes chat content.
FARO_COLLECTOR_URL=
RELEASE_VERSION=local
